<% content_for :title, "Accounts · #{@ledger.name}" %>

<%= page_header "Accounts", subtitle: "#{@ledger.name} chart of accounts" do %>
  <%= link_to "Back to ledger", ledger_path(@ledger), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "New account", new_ledger_account_path(@ledger), class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @accounts.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Normal</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @accounts.each do |account| %>
          <tr>
            <td class="px-5 py-3 text-sm font-mono text-gray-600"><%= account.code %></td>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to account.name, ledger_account_path(@ledger, account), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= enum_label(account, :account_type) %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= enum_label(account, :normal_balance) %></td>
            <td class="px-5 py-3"><%= status_badge(account) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Edit", edit_ledger_account_path(@ledger, account), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No accounts yet.</p>
  </div>
<% end %>
