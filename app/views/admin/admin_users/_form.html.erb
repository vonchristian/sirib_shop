<%= form_with model: [:admin, @admin_user], class: "space-y-6" do |form| %>
  <% if @admin_user.errors.any? %>
    <div class="rounded-sm bg-rose-50 border border-rose-200 p-4">
      <h3 class="text-sm font-semibold text-rose-800"><%= pluralize(@admin_user.errors.count, "error") %> prevented saving:</h3>
      <ul class="mt-2 list-disc list-inside text-sm text-rose-700">
        <% @admin_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.text_field :name, class: "block w-full rounded-sm border-gray-300 bg-gray-50 px-3 py-2.5 text-sm focus:border-teal-500 focus:ring-teal-500" %>
    </div>
    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.email_field :email, class: "block w-full rounded-sm border-gray-300 bg-gray-50 px-3 py-2.5 text-sm focus:border-teal-500 focus:ring-teal-500" %>
    </div>
    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.password_field :password, class: "block w-full rounded-sm border-gray-300 bg-gray-50 px-3 py-2.5 text-sm focus:border-teal-500 focus:ring-teal-500" %>
    </div>
    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.password_field :password_confirmation, class: "block w-full rounded-sm border-gray-300 bg-gray-50 px-3 py-2.5 text-sm focus:border-teal-500 focus:ring-teal-500" %>
    </div>
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.select :status, AdminUser.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "block w-full rounded-sm border-gray-300 bg-gray-50 px-3 py-2.5 text-sm focus:border-teal-500 focus:ring-teal-500" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Save admin user", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    <%= link_to "Cancel", admin_admin_users_path, class: "text-sm font-medium text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>
