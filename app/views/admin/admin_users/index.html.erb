<% content_for :title, "Admin users" %>

<%= page_header "Admin users", subtitle: "Platform operators" do %>
  <%= link_to "New admin user", new_admin_admin_user_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
        <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @admin_users.each do |admin_user| %>
        <tr>
          <td class="px-5 py-3 text-sm font-medium text-gray-900"><%= admin_user.name %></td>
          <td class="px-5 py-3 text-sm text-gray-600"><%= admin_user.email %></td>
          <td class="px-5 py-3"><%= status_badge(admin_user) %></td>
          <td class="px-5 py-3 text-right">
            <%= link_to "Edit", edit_admin_admin_user_path(admin_user), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
