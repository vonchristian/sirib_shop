<% content_for :title, "Carts" %>

<%= page_header "Carts", subtitle: "Active shopping carts" do %>
  <%= link_to "New cart", new_cart_path, class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @carts.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Cart</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Items</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @carts.each do |cart| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to "Cart ##{cart.id}", cart_path(cart), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= cart.customer&.name || "Walk-in" %></td>
            <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= cart.cart_lines.sum(:quantity) %></td>
            <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(cart.total_cents) %></td>
            <td class="px-5 py-3"><%= status_badge(cart) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", cart_path(cart), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No carts yet.</p>
  </div>
<% end %>
