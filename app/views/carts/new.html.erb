<% content_for :title, "New cart" %>

<%= page_header "New cart", subtitle: "Open a cart for a customer or walk-in" do %>
  <%= link_to "All carts", carts_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: carts_path, method: :post, local: true, scope: :cart, class: "max-w-xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div>
      <%= f.label :store_location_id, "Store location", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :store_location_id, current_business.store_locations.active, :id, :name, { prompt: "Select location" }, required: true, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div>
      <%= f.label :customer_id, "Customer", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :customer_id, current_business.customers.order(:name), :id, :name, { prompt: "Walk-in (no customer)" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div class="pt-2">
      <%= f.submit "Open cart", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
