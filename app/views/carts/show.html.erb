<% content_for :title, "Cart ##{@cart.id}" %>

<%= page_header "Cart ##{@cart.id}", subtitle: (@cart.customer&.name || "Walk-in") do %>
  <%= link_to "All carts", carts_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= button_to "Checkout", convert_cart_path(@cart), method: :post, form_class: "inline-flex", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Items</h2>
        <%= status_badge(@cart) %>
      </div>
      <% if @cart.cart_lines.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Item</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Subtotal</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @cart.cart_lines.each do |line| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900">
                  <%= line.product_variant.display_name %>
                  <span class="block text-xs text-gray-500"><%= line.product_variant.sku %></span>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= line.quantity %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(line.unit_price_cents) %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(line.line_total_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">This cart is empty.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Summary</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Subtotal</dt><dd class="font-medium text-gray-900"><%= money(@cart.subtotal_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Discount</dt><dd class="font-medium text-emerald-600">−<%= money(@cart.discount_cents) %></dd></div>
          <div class="flex justify-between border-t border-gray-100 pt-3"><dt class="font-semibold text-gray-900">Total</dt><dd class="font-bold text-gray-900"><%= money(@cart.total_cents) %></dd></div>
        </dl>
        <div class="mt-5">
          <%= button_to "Checkout", convert_cart_path(@cart), method: :post, class: "block w-full text-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
