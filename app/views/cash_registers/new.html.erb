<% content_for :title, "New cash register" %>

<%= page_header "New cash register", subtitle: "Add a register terminal" do %>
  <%= link_to "Back", cash_registers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: cash_registers_path, method: :post, local: true, scope: :cash_register, class: "max-w-xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div>
      <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div>
      <%= f.label :code, "Code", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :code, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div>
      <%= f.label :store_location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :store_location_id, StoreLocation.active, :id, :name, { include_blank: "Select location" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div class="pt-2">
      <%= f.submit "Create register", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
