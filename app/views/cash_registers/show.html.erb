<% content_for :title, @cash_register.name %>

<%= page_header @cash_register.name, subtitle: "#{@cash_register.code} · #{@cash_register.store_location.name}" do %>
  <%= link_to "All registers", cash_registers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "Edit", edit_cash_register_path(@cash_register), class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
  <%= link_to "Open session", new_cash_session_path(cash_register_id: @cash_register.id), class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Sessions</h2>
        <%= status_badge(@cash_register) %>
      </div>
      <% if @cash_register.cash_sessions.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Opened</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Opening</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @cash_register.cash_sessions.order(opened_at: :desc).each do |session| %>
              <tr>
                <td class="px-5 py-3 text-sm text-gray-900"><%= l session.opened_at, format: :short %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= session.user.name %></td>
                <td class="px-5 py-3 text-sm font-medium text-gray-900 text-right"><%= money(session.opening_amount_cents) %></td>
                <td class="px-5 py-3"><%= status_badge(session) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", cash_session_path(session), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No sessions yet.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Register details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Name</dt><dd class="font-medium text-gray-900"><%= @cash_register.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Code</dt><dd class="font-medium text-gray-900"><%= @cash_register.code %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Location</dt><dd class="font-medium text-gray-900"><%= @cash_register.store_location.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@cash_register) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
