<% content_for :title, "Cash session" %>

<%= page_header "Cash session", subtitle: "#{@cash_session.cash_register.name} · #{@cash_session.cash_register.store_location.name}" do %>
  <%= link_to "All sessions", cash_sessions_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <% if @cash_session.open? %>
    <%= form_with url: close_cash_session_path(@cash_session), method: :post, local: true, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :actual_closing_amount, value: money_input_value(CashSessionService.expected_closing_amount_cents(@cash_session)), placeholder: "Actual closing amount", inputmode: "decimal", class: "w-40 rounded-sm border-gray-300 shadow-sm text-sm" %>
      <%= f.submit "Close session", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    <% end %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Cash movements</h2>
        <%= status_badge(@cash_session) %>
      </div>
      <% if @cash_session.cash_movements.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @cash_session.cash_movements.order(occurred_at: :desc).each do |movement| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900"><%= enum_label(movement, :movement_type) %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= l movement.occurred_at, format: :short %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(movement.amount_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No cash movements yet.</p>
      <% end %>
    <% end %>

    <% if @cash_session.open? %>
      <%= card do %>
        <div class="p-5">
          <h2 class="text-base font-semibold text-gray-900 mb-3">Add cash in / cash out</h2>
          <%= form_with url: add_cash_cash_session_path(@cash_session), method: :post, local: true, class: "flex items-end gap-3" do |f| %>
            <div>
              <%= f.label :movement_type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :movement_type, [["Cash in", "cash_in"], ["Cash out", "cash_out"]], {}, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
            </div>
            <div>
              <%= f.label :amount, "Amount", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :amount, placeholder: "0.00", inputmode: "decimal", class: "w-32 rounded-sm border-gray-300 shadow-sm text-sm" %>
            </div>
            <div>
              <%= f.submit "Add", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Session summary</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Register</dt><dd class="font-medium text-gray-900"><%= @cash_session.cash_register.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">User</dt><dd class="font-medium text-gray-900"><%= @cash_session.user.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Opened</dt><dd class="font-medium text-gray-900"><%= l @cash_session.opened_at, format: :short %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Opening float</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.opening_amount_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Cash sales</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.cash_sales_amount_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Cash refunds</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.cash_refunds_amount_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Cash in</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.cash_ins_amount_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Cash out</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.cash_outs_amount_cents) %></dd></div>

          <% if @cash_session.closed? %>
            <div class="border-t border-gray-100 pt-2">
              <div class="flex justify-between"><dt class="text-gray-500">Expected</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.expected_closing_amount_cents) %></dd></div>
              <div class="flex justify-between"><dt class="text-gray-500">Actual</dt><dd class="font-medium text-gray-900"><%= money(@cash_session.actual_closing_amount_cents) %></dd></div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Difference</dt>
                <dd class="font-bold <%= @cash_session.difference_cents.to_i.zero? ? "text-emerald-600" : (@cash_session.difference_cents.to_i.negative? ? "text-rose-600" : "text-amber-600") %>">
                  <%= money(@cash_session.difference_cents) %>
                </dd>
              </div>
            </div>
          <% end %>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@cash_session) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
