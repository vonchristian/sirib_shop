<% content_for :title, "Categories" %>

<%= page_header "Categories", subtitle: "Organize your catalog" do %>
  <%= link_to "New category", new_category_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @categories.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Parent</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Products</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @categories.each do |category| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to category.name, category_path(category), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= category.code %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= category.parent&.name || "—" %></td>
            <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= category.products.count %></td>
            <td class="px-5 py-3"><%= status_badge(category) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", category_path(category), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No categories yet.</p>
  </div>
<% end %>
