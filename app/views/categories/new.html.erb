<% content_for :title, "New category" %>

<%= page_header "New category", subtitle: "Add a catalog category" do %>
  <%= link_to "Back", categories_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: categories_path, method: :post, local: true, scope: :category, class: "max-w-xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :code, "Code", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :code, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
    </div>
    <div>
      <%= f.label :parent_id, "Parent category", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :parent_id, Category.order(:name), :id, :name, { include_blank: "None (top level)" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div>
      <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :status, Category.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div class="pt-2">
      <%= f.submit "Create category", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
