<% content_for :title, @category.name %>

<%= page_header @category.name, subtitle: @category.code do %>
  <%= link_to "All categories", categories_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "Edit", edit_category_path(@category), class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Products</h2>
        <%= status_badge(@category) %>
      </div>
      <% if @category.products.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Product</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Brand</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @category.products.each do |product| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900">
                  <%= link_to product.name, product_path(product), class: "hover:text-teal-600" %>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= product.brand || "—" %></td>
                <td class="px-5 py-3"><%= status_badge(product) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No products in this category.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Category details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Code</dt><dd class="font-medium text-gray-900"><%= @category.code %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Parent</dt><dd class="font-medium text-gray-900"><%= @category.parent&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Products</dt><dd class="font-medium text-gray-900"><%= @category.products.count %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@category) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
