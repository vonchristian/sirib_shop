<li>
  <div class="flex items-center gap-2 rounded-sm hover:bg-gray-50 px-2 py-1" style="margin-left: <%= depth * 20 %>px;">
    <span class="inline-flex items-center justify-center size-6 rounded-full bg-teal-50 text-teal-700 text-xs font-bold"><%= node[:customer].name[0] %></span>
    <%= link_to node[:customer].name, customer_path(node[:customer]), class: "text-sm font-medium text-gray-900 hover:text-teal-600" %>
    <span class="text-xs text-gray-500"><%= enum_label(node[:customer], :customer_type) %></span>
    <%= status_badge(node[:customer]) %>
    <%= link_to "+", new_customer_path(parent_id: node[:customer].id), title: "Add sub-customer", class: "text-xs text-teal-600 hover:text-teal-500" %>
  </div>
  <% if node[:children].any? %>
    <ul class="space-y-1 mt-1">
      <% node[:children].each do |child| %>
        <%= render partial: "tree_node", locals: { node: child, depth: depth + 1 } %>
      <% end %>
    </ul>
  <% end %>
</li>
