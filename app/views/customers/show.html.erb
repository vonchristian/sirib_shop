<% content_for :title, @customer.name %>

<%= page_header @customer.name, subtitle: @customer.code do %>
  <%= link_to "All customers", customers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "Edit", edit_customer_path(@customer), class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Sales orders</h2>
        <%= status_badge(@customer) %>
      </div>
      <% if @customer.sales_orders.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @customer.sales_orders.order(ordered_at: :desc).limit(10).each do |order| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900">
                  <%= link_to order.number, sales_order_path(order), class: "hover:text-teal-600" %>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= l order.ordered_at, format: :short %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(order.total_cents) %></td>
                <td class="px-5 py-3"><%= status_badge(order) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No sales orders yet.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Customer details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Type</dt><dd class="font-medium text-gray-900"><%= enum_label(@customer, :customer_type) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Email</dt><dd class="font-medium text-gray-900"><%= @customer.email %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Phone</dt><dd class="font-medium text-gray-900"><%= @customer.phone %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">TIN</dt><dd class="font-medium text-gray-900"><%= @customer.tax_identifier || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Parent</dt><dd class="font-medium text-gray-900"><%= @customer.parent&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@customer) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
