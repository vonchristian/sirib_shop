<% content_for :title, "Customer Tree" %>

<%= page_header "Customer Tree", subtitle: "Hierarchical view of customers" do %>
  <%= link_to "All customers", customers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "New customer", new_customer_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @tree.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <ul class="space-y-2">
      <% @tree.each do |node| %>
        <%= render partial: "tree_node", locals: { node: node, depth: 0 } %>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No customers yet.</p>
  </div>
<% end %>
