<% content_for :title, "Journal Entries" %>

<%= page_header "Journal Entries", subtitle: "Posted accounting entries" do %>
  <%= link_to "New entry", new_journal_entry_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @journal_entries.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Entry</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Posted</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Debits</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Credits</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @journal_entries.each do |entry| %>
          <tr>
            <td class="px-5 py-3 text-sm font-mono text-gray-900">
              <%= link_to entry.entry_number, journal_entry_path(entry), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600 max-w-xs truncate"><%= entry.description %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= entry.posted_at ? l(entry.posted_at, format: :short) : "—" %></td>
            <td class="px-5 py-3 text-sm text-gray-900 text-right"><%= money(entry.total_debits_cents) %></td>
            <td class="px-5 py-3 text-sm text-gray-900 text-right"><%= money(entry.total_credits_cents) %></td>
            <td class="px-5 py-3"><%= status_badge(entry) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", journal_entry_path(entry), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No journal entries yet.</p>
  </div>
<% end %>
