<% content_for :title, "New journal entry" %>

<%= page_header "New journal entry", subtitle: "#{@ledger.name} · manual entry" do %>
  <%= link_to "Back", journal_entries_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: journal_entries_path, method: :post, local: true, class: "max-w-3xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div>
      <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :description, name: "journal_entry[description]", class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <%= f.label :lines, "Lines", class: "block text-sm font-medium text-gray-700" %>
        <span class="text-xs text-gray-500">Debits must equal credits</span>
      </div>
      <div class="space-y-2" data-controller="je-lines">
        <% 4.times do %>
          <div class="flex items-center gap-2 bg-gray-50 rounded-sm p-3">
            <select name="journal_entry[lines][][account_id]" class="rounded-sm border-gray-300 shadow-sm text-sm flex-1">
              <option value="">Select account</option>
              <% @accounts.each do |account| %>
                <option value="<%= account.id %>"><%= account.code %> · <%= account.name %></option>
              <% end %>
            </select>
            <input type="text" name="journal_entry[lines][][debit]" placeholder="Debit" inputmode="decimal" class="w-28 rounded-sm border-gray-300 shadow-sm text-sm">
            <input type="text" name="journal_entry[lines][][credit]" placeholder="Credit" inputmode="decimal" class="w-28 rounded-sm border-gray-300 shadow-sm text-sm">
            <input type="text" name="journal_entry[lines][][description]" placeholder="Line note" class="flex-1 rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
        <% end %>
      </div>
      <p class="text-xs text-gray-500 mt-1">Fill in the account and either a debit or credit amount per line.</p>
    </div>

    <div class="pt-2">
      <%= f.submit "Post entry", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
