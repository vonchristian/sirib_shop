<% content_for :title, @journal_entry.entry_number %>

<%= page_header @journal_entry.entry_number, subtitle: @journal_entry.ledger.name do %>
  <%= link_to "All entries", journal_entries_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <% if @journal_entry.posted? %>
    <%= button_to "Reverse entry", reverse_journal_entry_path(@journal_entry), method: :post, data: { turbo_confirm: "Post a reversal entry? The original entry will be marked reversed." }, class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Lines</h2>
        <%= status_badge(@journal_entry) %>
      </div>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Account</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
            <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Debit</th>
            <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Credit</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @lines.each do |line| %>
            <tr>
              <td class="px-5 py-3 text-sm text-gray-900">
                <p class="font-medium"><%= line.account.name %></p>
                <p class="text-xs text-gray-500 font-mono"><%= line.account.code %></p>
              </td>
              <td class="px-5 py-3 text-sm text-gray-600"><%= line.description %></td>
              <td class="px-5 py-3 text-sm text-gray-900 text-right"><%= money(line.debit_cents) %></td>
              <td class="px-5 py-3 text-sm text-gray-900 text-right"><%= money(line.credit_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Entry details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Ledger</dt><dd class="font-medium text-gray-900"><%= @journal_entry.ledger.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Description</dt><dd class="font-medium text-gray-900 max-w-[200px] text-right"><%= @journal_entry.description %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Occurred</dt><dd class="font-medium text-gray-900"><%= l @journal_entry.occurred_at, format: :short %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Posted</dt><dd class="font-medium text-gray-900"><%= @journal_entry.posted_at ? l(@journal_entry.posted_at, format: :short) : "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@journal_entry) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
