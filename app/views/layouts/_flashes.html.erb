<% if notice %>
  <div class="mb-6">
    <div class="flex items-center gap-x-3 rounded-xl border border-teal-200 bg-teal-50 px-4 py-3" data-controller="dismiss">
      <svg class="shrink-0 size-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
      <p class="text-sm text-teal-800"><%= notice %></p>
    </div>
  </div>
<% end %>

<% if alert %>
  <div class="mb-6">
    <div class="flex items-center gap-x-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3" data-controller="dismiss">
      <svg class="shrink-0 size-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
      <p class="text-sm text-rose-800"><%= alert %></p>
    </div>
  </div>
<% end %>
