<div class="sticky top-0 z-40 bg-white/80 backdrop-blur border-b border-gray-200">
  <div class="flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16">
    <div class="flex items-center gap-3">
      <button type="button" class="lg:hidden inline-flex items-center justify-center size-9 rounded-sm text-gray-500 hover:bg-gray-100" data-hs-overlay="#mobile-sidebar">
        <span class="sr-only">Open menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </button>
      <span class="text-sm text-gray-500 hidden sm:block"><%= current_business&.main_location&.name %></span>
    </div>

    <div class="hs-dropdown relative inline-flex">
      <button type="button" class="hs-dropdown-toggle flex items-center gap-x-2 rounded-full p-1.5 hover:bg-gray-100" data-hs-dropdown-toggle>
        <span class="inline-flex items-center justify-center size-8 rounded-full bg-teal-100 text-teal-700 font-semibold text-sm">
          <%= current_user&.name&.first&.upcase %>
        </span>
        <span class="hidden sm:block text-sm font-medium text-gray-700"><%= current_user&.name %></span>
        <svg class="size-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
      </button>

      <div class="hs-dropdown-menu transition-[opacity,margin] duration-[0.1ms] sm:duration-[150ms] hs-dropdown-open:opacity-100 opacity-0 hidden min-w-60 z-[60] bg-white shadow-xl rounded-xl border border-gray-200 mt-2 after:h-4 after:absolute after:-bottom-4 after:inset-x-0 after:content-['']" data-hs-dropdown-menu>
        <div class="px-4 py-3 border-b border-gray-100">
          <p class="text-sm font-medium text-gray-900"><%= current_user&.name %></p>
          <p class="text-xs text-gray-500 mt-0.5"><%= current_user&.email %></p>
        </div>
        <div class="py-1">
          <%= link_to logout_path, data: { turbo_method: :delete }, class: "flex items-center gap-x-2.5 px-4 py-2 text-sm text-rose-600 hover:bg-gray-50" do %>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" /></svg>
            Sign out
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
