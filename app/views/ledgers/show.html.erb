<% content_for :title, @ledger.name %>

<%= page_header @ledger.name, subtitle: @ledger.code do %>
  <%= link_to "All ledgers", ledgers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "New account", new_ledger_account_path(@ledger), class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Accounts</h2>
        <%= status_badge(@ledger) %>
      </div>
      <% if @accounts.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Normal</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @accounts.each do |account| %>
              <tr>
                <td class="px-5 py-3 text-sm font-mono text-gray-600"><%= account.code %></td>
                <td class="px-5 py-3 text-sm font-medium text-gray-900">
                  <%= link_to account.name, ledger_account_path(@ledger, account), class: "hover:text-teal-600" %>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= enum_label(account, :account_type) %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= enum_label(account, :normal_balance) %></td>
                <td class="px-5 py-3"><%= status_badge(account) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "View", ledger_account_path(@ledger, account), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No accounts yet.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Ledger details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Name</dt><dd class="font-medium text-gray-900"><%= @ledger.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Code</dt><dd class="font-medium text-gray-900"><%= @ledger.code %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Accounts</dt><dd class="font-medium text-gray-900"><%= @accounts.count %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Entries</dt><dd class="font-medium text-gray-900"><%= @ledger.journal_entries.count %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
