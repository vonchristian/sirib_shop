<% content_for :title, "Record payment" %>

<%= page_header "Record payment", subtitle: "#{@sales_order.number} · balance #{money(@sales_order.outstanding_balance_cents)}" do %>
  <%= link_to "Back to order", sales_order_path(@sales_order), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<div class="max-w-xl">
  <%= card do %>
    <div class="p-6">
      <%= form_with url: sales_order_payments_path(@sales_order), local: true, scope: :payment do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :payment_method, "Payment method", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :payment_method, Payment.payment_methods.keys.map { |k| [k.to_s.titleize, k] }, { include_blank: "Select method" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
          </div>

          <div>
            <%= f.label :amount, "Amount", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm text-gray-400">₱</span>
              <%= f.text_field :amount, value: money_input_value(@sales_order.outstanding_balance_cents), placeholder: "0.00", inputmode: "decimal", class: "w-full rounded-sm border-gray-300 shadow-sm pl-8 focus:border-teal-500 focus:ring-teal-500 text-sm" %>
            </div>
          </div>

          <div>
            <%= f.label :reference, "Reference (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :reference, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Record payment", class: "w-full inline-flex justify-center items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
