<% content_for :title, "Variants" %>

<%= page_header "Variants", subtitle: "All product variants across the catalog" do %>
  <%= link_to "Products", products_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<% if @product_variants.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Variant</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">SKU</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Cost</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tracked</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @product_variants.each do |variant| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to variant.display_name, variant_path(variant), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm font-mono text-gray-600"><%= variant.sku %></td>
            <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(variant.cost_price_cents) %></td>
            <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(variant.selling_price_cents) %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= variant.track_serial? ? "Yes" : "No" %></td>
            <td class="px-5 py-3"><%= status_badge(variant) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", variant_path(variant), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No variants yet.</p>
  </div>
<% end %>
