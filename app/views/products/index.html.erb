<% content_for :title, "Products" %>

<%= page_header "Products", subtitle: "Your catalog" do %>
  <%= link_to "New product", new_product_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @products.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Product</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Brand</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Variants</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @products.each do |product| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to product.name, product_path(product), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= product.brand || "—" %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= product.category&.name || "—" %></td>
            <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= product.variants.count %></td>
            <td class="px-5 py-3"><%= status_badge(product) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", product_path(product), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No products yet.</p>
  </div>
<% end %>
