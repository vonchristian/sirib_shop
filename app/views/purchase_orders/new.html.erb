<% content_for :title, "New purchase order" %>

<%= page_header "New purchase order", subtitle: "Order stock from a supplier" do %>
  <%= link_to "Back", purchase_orders_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: purchase_orders_path, method: :post, local: true, scope: :purchase_order, class: "max-w-3xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :supplier_id, "Supplier", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :supplier_id, Supplier.active, :id, :name, { include_blank: "Select supplier" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :destination_store_location_id, "Destination location", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :destination_store_location_id, StoreLocation.active, :id, :name, { include_blank: "Select location" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :lines, "Items", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <div class="space-y-2" data-controller="po-lines">
        <div class="flex items-center gap-3 bg-gray-50 rounded-sm p-3">
          <div class="flex-1">
            <%= f.collection_select :product_variant_id, ProductVariant.active, :id, :display_name, { include_blank: "Select product" }, { name: "purchase_order[lines][][product_variant_id]", class: "w-full rounded-sm border-gray-300 shadow-sm text-sm", "data-product-select" => "true" } %>
          </div>
          <input type="number" name="purchase_order[lines][][quantity]" value="1" min="0.001" step="0.001" class="w-24 rounded-sm border-gray-300 shadow-sm text-sm" placeholder="Qty">
          <input type="text" name="purchase_order[lines][][unit_cost]" placeholder="Unit cost" inputmode="decimal" class="w-28 rounded-sm border-gray-300 shadow-sm text-sm">
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-1">Add a new block per item. Leave the select blank on unused rows.</p>
    </div>

    <div class="pt-2">
      <%= f.submit "Create purchase order", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
