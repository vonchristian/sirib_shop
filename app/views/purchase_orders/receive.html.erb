<% content_for :title, "Receive #{@purchase_order.number}" %>

<%= page_header "Receive goods", subtitle: "#{@purchase_order.number} · #{@purchase_order.destination_store_location.name}" do %>
  <%= link_to "Back to PO", purchase_order_path(@purchase_order), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: receive_purchase_order_path(@purchase_order), method: :post, local: true, class: "max-w-3xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
    <% @lines.each do |line| %>
      <div class="border border-gray-200 rounded-sm p-4 space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= line.product_variant.display_name %></p>
            <p class="text-xs text-gray-500">
              <%= line.product_variant.sku %>
              · Outstanding <%= line.outstanding_quantity %>
              <% if line.product_variant.track_serial? %>
                · <span class="font-semibold text-violet-700">Serialized — IMEI/serial required</span>
              <% end %>
            </p>
          </div>
        </div>

        <input type="hidden" name="receive[][purchase_order_line_id]" value="<%= line.id %>">
        <div class="flex items-center gap-3">
          <label class="text-xs font-medium text-gray-600">Qty to receive</label>
          <input type="number" name="receive[][quantity]" value="<%= line.outstanding_quantity %>" min="0" step="0.001" class="w-28 rounded-sm border-gray-300 shadow-sm text-sm">
        </div>

        <% if line.product_variant.track_serial? %>
          <div class="space-y-2">
            <label class="text-xs font-semibold text-gray-600 uppercase tracking-wider">IMEI / serial entries</label>
            <% (1..[line.outstanding_quantity.to_i, 5].max).each do |i| %>
              <div class="flex items-center gap-2">
                <input type="text" name="receive[][serials][][imei_1]" placeholder="IMEI 1" class="flex-1 rounded-sm border-gray-300 shadow-sm text-sm">
                <input type="text" name="receive[][serials][][imei_2]" placeholder="IMEI 2 (optional)" class="flex-1 rounded-sm border-gray-300 shadow-sm text-sm">
                <input type="text" name="receive[][serials][][serial_number]" placeholder="Serial (optional)" class="flex-1 rounded-sm border-gray-300 shadow-sm text-sm">
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="pt-2">
      <%= f.submit "Receive goods", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
