<% content_for :title, @purchase_order.number %>

<%= page_header @purchase_order.number, subtitle: "#{@purchase_order.supplier.name} · #{@purchase_order.destination_store_location.name}" do %>
  <%= link_to "All POs", purchase_orders_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <% if @purchase_order.draft? %>
    <%= button_to "Cancel", cancel_purchase_order_path(@purchase_order), method: :post, data: { turbo_confirm: "Cancel this purchase order?" }, class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
    <%= button_to "Submit", submit_purchase_order_path(@purchase_order), method: :post, class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
  <% if @purchase_order.submitted? %>
    <%= button_to "Approve", approve_purchase_order_path(@purchase_order), method: :post, class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
  <% if @purchase_order.receivable? %>
    <%= link_to "Receive goods", receive_purchase_order_path(@purchase_order), class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Lines</h2>
        <%= status_badge(@purchase_order) %>
      </div>
      <% if @purchase_order.purchase_order_lines.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Item</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Received</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Unit cost</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @purchase_order.purchase_order_lines.each do |line| %>
              <tr>
                <td class="px-5 py-3 text-sm text-gray-900">
                  <p class="font-medium"><%= line.product_variant.display_name %></p>
                  <p class="text-xs text-gray-500"><%= line.product_variant.sku %></p>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= line.quantity %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= line.received_quantity %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(line.unit_cost_cents) %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(line.total_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No lines on this purchase order.</p>
      <% end %>

      <div class="p-5 border-t border-gray-100">
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Subtotal</dt><dd class="font-medium text-gray-900"><%= money(@purchase_order.subtotal_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Tax</dt><dd class="font-medium text-gray-900"><%= money(@purchase_order.tax_total_cents) %></dd></div>
          <div class="flex justify-between pt-2 border-t border-gray-100"><dt class="font-semibold text-gray-900">Total</dt><dd class="font-bold text-gray-900"><%= money(@purchase_order.total_cents) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Order details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Supplier</dt><dd class="font-medium text-gray-900"><%= link_to @purchase_order.supplier.name, @purchase_order.supplier, class: "text-teal-600 hover:text-teal-500" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Destination</dt><dd class="font-medium text-gray-900"><%= @purchase_order.destination_store_location.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Ordered</dt><dd class="font-medium text-gray-900"><%= l @purchase_order.ordered_at, format: :short %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Created by</dt><dd class="font-medium text-gray-900"><%= @purchase_order.created_by_user&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@purchase_order) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
