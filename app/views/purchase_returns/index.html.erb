<% content_for :title, "Purchase Returns" %>

<%= page_header "Purchase Returns", subtitle: "Return stock to suppliers" %>

<% if @purchase_returns.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Return</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">PO</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Supplier</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Reason</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @purchase_returns.each do |purchase_return| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to purchase_return.number, purchase_return_path(purchase_return), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= purchase_return.purchase_order.number %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= purchase_return.supplier.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= purchase_return.store_location.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600 max-w-xs truncate"><%= purchase_return.reason %></td>
            <td class="px-5 py-3"><%= status_badge(purchase_return) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", purchase_return_path(purchase_return), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No purchase returns yet.</p>
  </div>
<% end %>
