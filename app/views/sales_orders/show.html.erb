<% content_for :title, @sales_order.number %>

<%= page_header "#{@sales_order.number} · #{money(@sales_order.total_cents)}", subtitle: "#{@sales_order.store_location.name} · #{l @sales_order.ordered_at, format: :long}" do %>
  <%= link_to "All orders", sales_orders_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <% if @sales_order.draft? || @sales_order.confirmed? %>
    <%= button_to "Cancel order", cancel_sales_order_path(@sales_order), method: :post, data: { turbo_confirm: "Cancel this order?" }, class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
  <% end %>
  <% if @sales_order.outstanding_balance_cents > 0 %>
    <%= link_to "Record payment", new_sales_order_payment_path(@sales_order), class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
  <% if @sales_order.confirmed? %>
    <%= button_to "Post sale", post_sales_order_path(@sales_order), method: :post, class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Lines</h2>
        <%= status_badge(@sales_order) %>
      </div>
      <% if @sales_order.sales_order_lines.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Item</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @sales_order.sales_order_lines.each do |line| %>
              <tr>
                <td class="px-5 py-3 text-sm text-gray-900">
                  <p class="font-medium"><%= line.product_variant.display_name %></p>
                  <p class="text-xs text-gray-500"><%= line.product_variant.sku %></p>
                </td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= line.quantity %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(line.unit_price_cents) %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(line.total_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No lines on this order.</p>
      <% end %>

      <div class="p-5 border-t border-gray-100">
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Subtotal</dt><dd class="font-medium text-gray-900"><%= money(@sales_order.subtotal_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Discount</dt><dd class="font-medium text-gray-900"><%= money(@sales_order.discount_total_cents) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Tax</dt><dd class="font-medium text-gray-900"><%= money(@sales_order.tax_total_cents) %></dd></div>
          <div class="flex justify-between pt-2 border-t border-gray-100"><dt class="font-semibold text-gray-900">Total</dt><dd class="font-bold text-gray-900"><%= money(@sales_order.total_cents) %></dd></div>
        </dl>
      </div>
    <% end %>

    <%= card do %>
      <div class="p-5 border-b border-gray-100">
        <h2 class="text-base font-semibold text-gray-900">Payments</h2>
      </div>
      <% if @payments.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <tbody class="divide-y divide-gray-100">
              <% @payments.each do |payment| %>
                <tr>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900"><%= payment.payment_method.to_s.titleize %></td>
                  <td class="px-5 py-3 text-sm text-gray-600"><%= l payment.paid_at, format: :short %></td>
                  <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(payment.amount_cents) %></td>
                  <td class="px-5 py-3 text-right"><%= status_badge(payment) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No payments recorded.</p>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-6">
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Order details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Customer</dt><dd class="font-medium text-gray-900"><%= @sales_order.customer&.name || "Walk-in" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Location</dt><dd class="font-medium text-gray-900"><%= @sales_order.store_location.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@sales_order) %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Ordered</dt><dd class="font-medium text-gray-900"><%= l @sales_order.ordered_at, format: :short %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Created by</dt><dd class="font-medium text-gray-900"><%= @sales_order.created_by_user&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Balance</dt><dd class="font-bold text-gray-900"><%= money(@sales_order.outstanding_balance_cents) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
