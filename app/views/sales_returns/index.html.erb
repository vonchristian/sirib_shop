<% content_for :title, "Sales Returns" %>

<%= page_header "Sales Returns", subtitle: "Process customer returns and restock" %>

<% if @sales_returns.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Return</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Reason</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @sales_returns.each do |sales_return| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to sales_return.number, sales_return_path(sales_return), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= sales_return.sales_order.number %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= sales_return.customer&.name || "—" %></td>
            <td class="px-5 py-3 text-sm text-gray-600 max-w-xs truncate"><%= sales_return.reason %></td>
            <td class="px-5 py-3"><%= status_badge(sales_return) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", sales_return_path(sales_return), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No sales returns yet.</p>
  </div>
<% end %>
