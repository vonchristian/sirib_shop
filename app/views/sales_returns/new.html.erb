<% content_for :title, "New sales return" %>

<%= page_header "New sales return", subtitle: "Record a customer return" do %>
  <%= link_to "Back", sales_returns_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: sales_returns_path, method: :post, local: true, scope: :sales_return, class: "max-w-2xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :sales_order_id, "Sales order", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :sales_order_id, SalesOrder.order(ordered_at: :desc).limit(100), :id, :number, { include_blank: "Select order" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :store_location_id, "Return location", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :store_location_id, StoreLocation.active, :id, :name, { include_blank: "Select location" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :reason, "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :reason, rows: 3, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>

    <div>
      <%= f.label :lines, "Items to return", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <% if params[:sales_order_id].present? %>
        <% order = SalesOrder.find_by(id: params[:sales_order_id]) %>
        <% if order %>
          <div class="space-y-2" data-controller="line-row">
            <% order.sales_order_lines.each do |line| %>
              <div class="flex items-center gap-3 bg-gray-50 rounded-sm p-3">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900"><%= line.product_variant.display_name %></p>
                  <p class="text-xs text-gray-500">Ordered <%= line.quantity %> @ <%= money(line.unit_price_cents) %></p>
                </div>
                <input type="hidden" name="sales_return[lines][][product_variant_id]" value="<%= line.product_variant_id %>">
                <div class="flex items-center gap-2">
                  <label class="text-xs text-gray-500">Qty</label>
                  <input type="number" name="sales_return[lines][][quantity]" value="<%= line.quantity %>" min="0" step="0.001" class="w-24 rounded-sm border-gray-300 shadow-sm text-sm">
                  <label class="text-xs text-gray-500">Price</label>
                  <input type="text" name="sales_return[lines][][unit_price]" value="<%= money_input_value(line.unit_price_cents) %>" class="w-28 rounded-sm border-gray-300 shadow-sm text-sm">
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">Select a sales order to populate its lines.</p>
      <% end %>
    </div>

    <div class="pt-2">
      <%= f.submit "Create return", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
