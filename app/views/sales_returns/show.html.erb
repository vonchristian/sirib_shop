<% content_for :title, @sales_return.number %>

<%= page_header @sales_return.number, subtitle: "Return for #{@sales_return.sales_order.number} · #{@sales_return.store_location.name}" do %>
  <%= link_to "All returns", sales_returns_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <% if @sales_return.open? %>
    <%= button_to "Complete return", complete_sales_return_path(@sales_return), method: :post, data: { turbo_confirm: "Complete this return and restock items?" }, class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Return lines</h2>
        <%= status_badge(@sales_return) %>
      </div>
      <% if @sales_return.sales_return_lines.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Item</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Unit price</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @sales_return.sales_return_lines.each do |line| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900"><%= line.product_variant.display_name %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= line.quantity %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(line.unit_price_cents) %></td>
                <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money((line.quantity * line.unit_price_cents).round) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No lines on this return.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Return details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Order</dt><dd class="font-medium text-gray-900"><%= link_to @sales_return.sales_order.number, sales_order_path(@sales_return.sales_order), class: "text-teal-600 hover:text-teal-500" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Customer</dt><dd class="font-medium text-gray-900"><%= @sales_return.customer&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Location</dt><dd class="font-medium text-gray-900"><%= @sales_return.store_location.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Reason</dt><dd class="font-medium text-gray-900"><%= @sales_return.reason || "—" %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@sales_return) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
