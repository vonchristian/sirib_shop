<% content_for :title, "Asset Categories" %>

<%= page_header "Asset Categories", subtitle: "Kinds of serviceable assets (Phone, Computer, Motorcycle, Automobile)" do %>
  <%= link_to "New category", new_service_asset_category_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @categories.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @categories.each do |category| %>
      <%= link_to service_asset_category_path(category), class: "block bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition p-5" do %>
        <div class="flex items-start justify-between">
          <h2 class="text-base font-semibold text-gray-900"><%= category.name %></h2>
          <%= category.active ? content_tag(:span, "Active", class: "text-xs font-semibold text-emerald-600") : content_tag(:span, "Inactive", class: "text-xs font-semibold text-gray-400") %>
        </div>
        <% if category.description.present? %>
          <p class="mt-1 text-sm text-gray-500"><%= category.description %></p>
        <% end %>
        <div class="mt-3 flex gap-4 text-xs text-gray-500">
          <span><%= pluralize category.service_asset_fields.count, "field" %></span>
          <span><%= pluralize category.service_assets.count, "asset" %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No categories yet.</p>
  </div>
<% end %>
