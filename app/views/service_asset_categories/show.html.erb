<% content_for :title, @category.name %>

<%= page_header @category.name, subtitle: @category.description do %>
  <%= link_to "All categories", service_asset_categories_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "Edit", edit_service_asset_category_path(@category), class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
  <%= link_to "Add field", new_service_asset_category_field_path(@category), class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Fields</h2>
        <%= content_tag(:span, @category.active ? "Active" : "Inactive", class: "text-xs font-semibold #{@category.active ? "text-emerald-600" : "text-gray-400"}") %>
      </div>
      <% if @category.service_asset_fields.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Field</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Label</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Req.</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Active</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @category.service_asset_fields.ordered.each do |field| %>
              <tr>
                <td class="px-5 py-3 text-sm font-mono text-gray-900"><%= field.name %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= field.label %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= field.data_type.to_s.titleize %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= field.required ? "Yes" : "No" %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= field.active ? "Yes" : "No" %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Edit", edit_field_path(field), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No fields defined. Add fields to capture typed identifiers for this category.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Category</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Name</dt><dd class="font-medium text-gray-900"><%= @category.name %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Fields</dt><dd class="font-medium text-gray-900"><%= @category.service_asset_fields.count %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Assets</dt><dd class="font-medium text-gray-900"><%= @category.service_assets.count %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd class="font-medium text-gray-900"><%= @category.active ? "Active" : "Inactive" %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
