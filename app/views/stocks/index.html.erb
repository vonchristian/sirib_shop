<% content_for :title, "Stock" %>

<%= page_header "Stock", subtitle: "Inventory levels by location" do %>
  <%= link_to "Serialized Units", inventory_items_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="p-4 border-b border-gray-100 flex flex-wrap items-center gap-2">
    <%= form_with url: stocks_path, method: :get, class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.collection_select :store_location_id, StoreLocation.order(:name), :id, :name, { include_blank: "All locations" }, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      <%= f.collection_select :product_variant_id, ProductVariant.order(:sku), :id, :display_name, { include_blank: "All variants" }, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      <label class="flex items-center gap-1 text-sm text-gray-600">
        <%= f.check_box :low, { checked: params[:low].present? }, "1", nil %>
        Low stock only
      </label>
      <%= f.submit "Filter", class: "rounded-sm bg-teal-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-teal-500" %>
    <% end %>
  </div>

  <% if @stocks.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Item</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Qty</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Reserved</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Available</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @stocks.each do |stock| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to stock.product_variant.display_name, variant_path(stock.product_variant), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= stock.store_location.name %></td>
            <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= stock.quantity %></td>
            <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= stock.reserved_quantity %></td>
            <td class="px-5 py-3 text-sm <%= stock.available_quantity <= 0 ? "text-rose-600 font-semibold" : "text-gray-900 font-semibold" %> text-right"><%= stock.available_quantity %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", stock_path(stock), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="p-10 text-sm text-gray-500 text-center">No stock records.</p>
  <% end %>
</div>

<%= card do %>
  <div class="p-5 border-b border-gray-100">
    <h2 class="text-base font-semibold text-gray-900">Adjust stock</h2>
  </div>
  <div class="p-5">
    <%= form_with url: adjust_stocks_path, method: :post, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :product_variant_id, "Variant", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :product_variant_id, ProductVariant.order(:sku), :id, :display_name, { include_blank: "Select" }, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <%= f.label :store_location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :store_location_id, StoreLocation.order(:name), :id, :name, { include_blank: "Select" }, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <%= f.label :movement_type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :movement_type, [%w[Spoilage spoilage], %w[Internal\ use internal_use], %w[Adjustment adjustment]], {}, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <%= f.label :direction, "Direction", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :direction, [["Out (remove)", "out"], ["In (add)", "in"]], {}, class: "rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <%= f.label :quantity, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :quantity, value: 1, min: 0, step: "0.001", class: "w-28 rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <div>
        <%= f.label :unit_cost, "Unit cost", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :unit_cost, placeholder: "0.00", inputmode: "decimal", class: "w-28 rounded-sm border-gray-300 shadow-sm text-sm" %>
      </div>
      <%= f.submit "Adjust", class: "rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-500" %>
    <% end %>
  </div>
<% end %>
