<% content_for :title, "Store Locations" %>

<%= page_header "Store Locations", subtitle: "Branches and warehouses" do %>
  <%= link_to "New location", new_store_location_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @store_locations.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Location</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Code</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Address</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @store_locations.each do |location| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to location.name, store_location_path(location), class: "hover:text-teal-600" %>
              <% if location.is_main? %>
                <span class="ml-2 inline-flex items-center rounded-full bg-teal-50 px-2 py-0.5 text-xs font-semibold text-teal-700">Main</span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= location.code %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= enum_label(location, :location_type) %></td>
            <td class="px-5 py-3 text-sm text-gray-600 max-w-xs truncate"><%= location.address %></td>
            <td class="px-5 py-3"><%= status_badge(location) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", store_location_path(location), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No store locations yet.</p>
  </div>
<% end %>
