<% content_for :title, "New supplier" %>

<%= page_header "New supplier", subtitle: "Add a vendor" do %>
  <%= link_to "Back", suppliers_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: suppliers_path, method: :post, local: true, scope: :supplier, class: "max-w-xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :supplier_type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :supplier_type, Supplier.supplier_types.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :code, "Code", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :code, placeholder: "S-0001", class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :phone, "Phone", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :phone, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div>
        <%= f.label :tax_identifier, "Tax identifier", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :tax_identifier, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
    </div>
    <div>
      <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :status, Supplier.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
    </div>
    <div class="pt-2">
      <%= f.submit "Create supplier", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
