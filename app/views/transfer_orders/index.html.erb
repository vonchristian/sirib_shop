<% content_for :title, "Transfer Orders" %>

<%= page_header "Transfer Orders", subtitle: "Move stock between locations" do %>
  <%= link_to "New transfer", new_transfer_order_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @transfer_orders.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Transfer</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">From</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">To</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @transfer_orders.each do |to| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to to.number, transfer_order_path(to), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= to.origin_store_location.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= to.destination_store_location.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= l to.created_at, format: :short %></td>
            <td class="px-5 py-3"><%= status_badge(to) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", transfer_order_path(to), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No transfer orders yet.</p>
  </div>
<% end %>
