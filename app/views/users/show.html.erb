<% content_for :title, @user.name %>

<%= page_header @user.name, subtitle: @user.email do %>
  <%= link_to "All users", users_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
  <%= link_to "Edit", edit_user_path(@user), class: "inline-flex items-center rounded-sm border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <%= card do %>
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Cash sessions</h2>
        <%= status_badge(@user) %>
      </div>
      <% if @user.cash_sessions.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Register</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Opened</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Opening</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @user.cash_sessions.order(opened_at: :desc).limit(10).each do |session| %>
              <tr>
                <td class="px-5 py-3 text-sm font-medium text-gray-900"><%= session.cash_register.name %></td>
                <td class="px-5 py-3 text-sm text-gray-600"><%= l session.opened_at, format: :short %></td>
                <td class="px-5 py-3 text-sm text-gray-600 text-right"><%= money(session.opening_amount_cents) %></td>
                <td class="px-5 py-3"><%= status_badge(session) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-5 text-sm text-gray-500">No cash sessions yet.</p>
      <% end %>
    <% end %>
  </div>

  <div>
    <%= card do %>
      <div class="p-5">
        <h2 class="text-base font-semibold text-gray-900 mb-4">User details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Email</dt><dd class="font-medium text-gray-900"><%= @user.email %></dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd><%= status_badge(@user) %></dd></div>
        </dl>
      </div>
    <% end %>
  </div>
</div>
