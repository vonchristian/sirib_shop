<% content_for :title, "Work Orders" %>

<%= page_header "Work Orders", subtitle: "Track repairs and services" do %>
  <%= link_to "New work order", new_work_order_path, class: "inline-flex items-center gap-x-2 rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
<% end %>

<% if @work_orders.any? %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-gray-100">
      <div class="flex flex-wrap items-center gap-2">
        <% [nil, :received, :diagnosing, :waiting_for_approval, :approved, :in_progress, :waiting_for_parts, :ready_for_release, :released, :cancelled].each do |status| %>
          <% active = params[:status].blank? ? status.nil? : params[:status] == status.to_s %>
          <%= link_to (status || "All").to_s.tr("_", " ").titleize, work_orders_path(status: status), class: "inline-flex items-center rounded-full px-3 py-1 text-sm font-medium #{active ? "bg-teal-600 text-white" : "bg-gray-100 text-gray-600 hover:bg-gray-200"}" %>
        <% end %>
      </div>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">WO</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Asset</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Assigned</th>
          <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Priority</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @work_orders.each do |wo| %>
          <tr>
            <td class="px-5 py-3 text-sm font-medium text-gray-900">
              <%= link_to wo.number, work_order_path(wo), class: "hover:text-teal-600" %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= wo.service_asset.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= wo.customer.name %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= wo.assigned_user&.name || "—" %></td>
            <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right"><%= money(wo.total_cents) %></td>
            <td class="px-5 py-3"><%= status_badge(wo) %></td>
            <td class="px-5 py-3 text-sm text-gray-600"><%= wo.priority.to_s.titleize %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "View", work_order_path(wo), class: "text-sm font-medium text-teal-600 hover:text-teal-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">
    <p class="text-sm text-gray-500">No work orders yet.</p>
  </div>
<% end %>
