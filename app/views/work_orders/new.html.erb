<% content_for :title, "New work order" %>

<%= page_header "New work order", subtitle: "Receive a customer-owned asset for repair or service" do %>
  <%= link_to "Back", work_orders_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
<% end %>

<%= form_with url: work_orders_path, method: :post, local: true, scope: :work_order, class: "max-w-3xl" do |f| %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-6">
    <div>
      <h2 class="text-base font-semibold text-gray-900 mb-3">Order</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :store_location_id, "Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :store_location_id, StoreLocation.active, :id, :name, { include_blank: "Select" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
        </div>
        <div>
          <%= f.label :service_asset_id, "Service asset", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :service_asset_id, ServiceAsset.includes(:service_asset_category).ordered, :id, :display_name, { include_blank: "Select asset" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
        </div>
        <div>
          <%= f.label :assigned_user_id, "Assigned to", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :assigned_user_id, User.active, :id, :name, { include_blank: "Unassigned" }, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
        </div>
        <div>
          <%= f.label :priority, "Priority", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :priority, WorkOrder.priorities.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.label :complaint, "Complaint", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :complaint, rows: 3, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
      <div class="mt-4">
        <%= f.label :notes, "Notes", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :notes, rows: 2, class: "w-full rounded-sm border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 text-sm" %>
      </div>
    </div>

    <div>
      <h2 class="text-base font-semibold text-gray-900 mb-3">Services / labor</h2>
      <div class="space-y-2">
        <div class="flex items-center gap-3 bg-gray-50 rounded-sm p-3">
          <div class="flex-1">
            <input type="text" name="work_order[services][][name]" placeholder="Service name (e.g. Screen Replacement)" class="w-full rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
          <div class="w-32">
            <input type="text" name="work_order[services][][unit_price]" placeholder="Price" inputmode="decimal" class="w-full rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
          <div class="w-24">
            <input type="number" name="work_order[services][][quantity]" value="1" min="0.001" step="0.001" class="w-full rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-1">Add a new block per service. Leave unused rows empty.</p>
    </div>

    <div>
      <h2 class="text-base font-semibold text-gray-900 mb-3">Parts (estimate)</h2>
      <div class="space-y-2">
        <div class="flex items-center gap-3 bg-gray-50 rounded-sm p-3">
          <select name="work_order[parts][][product_variant_id]" class="rounded-sm border-gray-300 shadow-sm text-sm">
            <option value="">Select part</option>
            <% ProductVariant.active.each do |pv| %>
              <option value="<%= pv.id %>"><%= pv.display_name %></option>
            <% end %>
          </select>
          <div class="w-24">
            <input type="number" name="work_order[parts][][quantity]" value="1" min="0.001" step="0.001" class="w-full rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
          <div class="w-32">
            <input type="text" name="work_order[parts][][unit_price]" placeholder="Price" inputmode="decimal" class="w-full rounded-sm border-gray-300 shadow-sm text-sm">
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-1">Estimating parts never reduces stock. Consume them from the work order after approval.</p>
    </div>

    <div class="pt-2">
      <%= f.submit "Create work order", class: "inline-flex items-center rounded-sm bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  </div>
<% end %>
